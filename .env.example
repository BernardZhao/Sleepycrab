# Copy to .env and fill in. .env is gitignored — never commit real values.

# Proton VPN WireGuard private key (config generated with NAT-PMP / port
# forwarding ON). Full generated config is kept on the host at
# /root/secrets/wg0.conf (not in this repo).
WIREGUARD_PRIVATE_KEY=

# Cloudflare Tunnel token for the cloudflared-tunnel service.
TUNNEL_TOKEN=

# WUD (What's Up Docker): ntfy access token for major-update alerts
# (dedicated write-only ntfy user "wud", topic "homeserver").
WUD_NTFY_TOKEN=

# WUD web UI admin password (user "admin", UI on port 3000).
WUD_ADMIN_PASSWORD=

# Optional overrides (defaults shown):
# HOST_IP=10.0.0.11        # LAN IP of the Docker host (Plex advertise, traefik)
# LAN_SUBNET=10.0.0.0/24   # LAN subnet gluetun may reach outside the tunnel
# DATA_ROOT=/data          # Root of the media/downloads pool (mergerfs mount)
